# docker compose 용 환경변수. 이 파일을 .env 로 복사해 쓰고, .env 는 커밋하지 않는다.

# --- 결정 모델 -------------------------------------------------------------
# auto: JEV_API_KEY가 있으면 Jev → 없으면 OPENAI_API_KEY(LLM 로그 확률) → 둘 다 없으면 로컬 보정 분류기
DECISION_PROVIDER=auto
# TypeSafe Jev (https://docs.aimlapi.com/api-references/decision-models/typesafe/jev)
JEV_API_KEY=
JEV_BASE_URL=https://api.aimlapi.com
# 임계값을 보정한 버전에 고정한다. 버전을 바꾸면 정답 세트 검증을 다시 돌린다.
JEV_MODEL=typesafe/jev-1.14

# OpenAI: 보완 안내 문구 다듬기 · 규정 조건 초안 · 규정 임베딩 · (Jev가 없을 때) 로그 확률 판정
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- 보안 값 (운영에서는 반드시 바꾼다) ---------------------------------------
APP_JWT_SECRET=local-dev-only-secret-change-me-0123456789
AI_INTERNAL_TOKEN=local-internal-token
DB_PASSWORD=evidence-local
APP_DEMO_PASSWORD=demo1234

WEB_PORT=8088
